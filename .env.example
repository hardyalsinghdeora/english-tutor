# Copy this file to .env and fill in ONE key.
# Which AI to use: gemini or openai
PROVIDER=gemini

# Get a Gemini key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Get an OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

PORT=3000

# Student accounts
# Postgres for accounts (e.g. free at https://neon.tech). Leave empty to use a local file (data/dev.db).
DATABASE_URL=
# Long random string that signs login cookies (required on a real server): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Optional "Continue with Google" (Google Cloud Console > Credentials > OAuth client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chat messages per student per day
DAILY_MESSAGES=100
